/dts-v1/;
/memreserve/ 0x80000000 0x10000;

#include "firefly_v1.dtsi"

/{
	model = "Firefly Development Board v1";
	compatible = "firefly,dsk_v1";
	#address-cells = <2>;
	#size-cells = <2>;

	chosen {
		stdout-path = "uart1:115200n8";
	};

	memory@0{
		device_type = "memory";
		reg = <0x0 0x80000000 0x1 0x00000000>;
	};

	memory@1{
		device_type = "memory";
		reg = <0x20 0x00000000 0x1 0x00000000>;
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};
};

&uart1 {
	status = "ok";
};

&gmac0 {
	status = "ok";
	phy-mode = "rgmii-id";
};

&gmac1 {
	status = "ok";
	phy-mode = "rgmii-id";
};

&i2c0 {
	status = "ok";
};

&i2c1 {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	rtc@68 {
		compatible = "dallas,ds1339";
		reg = <0x68>;
	};
};
